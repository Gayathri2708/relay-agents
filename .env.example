# Any OpenAI-compatible endpoint. Groq shown here.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_MAX_RETRIES=2

DATABASE_URL=postgresql:///relay

# DocPilot (github.com/Gayathri2708/docpilot-rag). Relay only needs a READ-ONLY key
# with the engineering group, e.g. the local demo key dp_demo_engineering.
DOCPILOT_URL=http://localhost:8000
DOCPILOT_API_KEY=

# Only used by seed/upload_runbooks.py. Needs an admin key that can write to "engineering".
DOCPILOT_ADMIN_KEY=
