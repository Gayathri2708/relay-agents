# Any OpenAI-compatible endpoint. Groq shown here.
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=3000
# Client-side pacing per model (0 = off). Groq free tier: LLM_TPM=8000, LLM_RPM=30.
LLM_TPM=0
LLM_RPM=0

# Model routing: a small fast model for triage, a stronger one for reasoning.
MODEL_TRIAGE=openai/gpt-oss-20b
MODEL_INVESTIGATE=openai/gpt-oss-120b
MODEL_PLAN=openai/gpt-oss-120b
MODEL_QA=openai/gpt-oss-120b
MODEL_POSTMORTEM=openai/gpt-oss-120b
# USD per 1M tokens [input, output], as JSON. Defaults cover the models above (Groq, Oct 2026).
# LLM_PRICES={"openai/gpt-oss-20b": [0.075, 0.30], "openai/gpt-oss-120b": [0.15, 0.60]}

# QA gate: max times it may send work back, and the confidence below which a human must review.
QA_MAX_LOOPS=2
QA_MIN_CONFIDENCE=0.6

DATABASE_URL=postgresql:///relay

# API keys for the HTTP API and dashboard (empty = open, development only). Keys need 16+ characters.
# reporter: submit and read (give this one to the MCP server). approver: also decide, resolve, postmortem.
# RELAY_API_KEYS={"gayathri": {"key": "<random>", "role": "approver"}, "claude-desktop": {"key": "<random>", "role": "reporter"}}

# DocPilot (github.com/Gayathri2708/docpilot-rag). Relay only needs a READ-ONLY key
# with the engineering group, e.g. the local demo key dp_demo_engineering.
DOCPILOT_URL=http://localhost:8000
DOCPILOT_API_KEY=

# Only used by seed/upload_runbooks.py. Needs an admin key that can write to "engineering".
DOCPILOT_ADMIN_KEY=
